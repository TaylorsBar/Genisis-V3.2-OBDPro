{
  "name": "karapiro-cartel-speed-shop",
  "version": "1.0.0",
  "description": "An intelligent, end-to-end web app that empowers drivers and mechanics with next-generation vehicle health, tuning, and maintenance tools using AI.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "android:sync": "npx cap sync android",
    "android:copy": "npx cap copy android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@google/genai": "^1.45.0",
    "@vis.gl/react-google-maps": "^1.9.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "framer-motion": "^12.38.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.344.0",
    "mathjs": "^15.2.0",
    "motion": "^12.35.2",
    "onnxruntime-web": "^1.24.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "~5.0.6",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.1",
    "@webgpu/types": "^0.1.69",
    "esbuild": "^0.28.1",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.25.1",
    "tsx": "^4.22.4",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.1"
  },
  "author": "",
  "license": "ISC"
}
